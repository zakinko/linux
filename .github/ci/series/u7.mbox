 			    struct xdr_netobj *label)
@@ -509,6 +544,7 @@ nfsd4_decode_posixacl(struct nfsd4_compoundargs *argp, struct posix_acl **acl)
 static __be32
 nfsd4_decode_fattr4(struct nfsd4_compoundargs *argp, u32 *bmval, u32 bmlen,
 		    struct iattr *iattr, struct nfs4_acl **acl,
+		    struct nfs4_acl **dacl, struct nfs4_acl **sacl,
 		    struct xdr_netobj *label, int *umask,
 		    struct posix_acl **dpaclp, struct posix_acl **paclp)
 {
@@ -638,6 +674,18 @@ nfsd4_decode_fattr4(struct nfsd4_compoundargs *argp, u32 *bmval, u32 bmlen,
 		if (status)
