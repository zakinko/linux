+			return nfserr_attrnotsupp;
+	}
 	if ((bmval[2] & (FATTR4_WORD2_POSIX_DEFAULT_ACL |
 					FATTR4_WORD2_POSIX_ACCESS_ACL)) &&
 					!IS_POSIXACL(d_inode(dentry)))
@@ -384,14 +392,17 @@ nfsd4_create_file(struct svc_rqst *rqstp, struct svc_fh *fhp,
 			/* Cannot specify both NFSv4 and Posix ACLs */
 			return nfserr_inval;
 		}
-		status = nfsd4_acl_to_attr(NF4REG, open->op_acl,
-						   &attrs);
+		status = nfsd4_acl_to_attr(d_inode(parent.dentry), NF4REG,
+					   open->op_acl, &attrs);
 		if (status)
 			return status;
 	} else {
 		attrs.na_dpacl = posix_acl_dup(open->op_dpacl);
 		attrs.na_pacl = posix_acl_dup(open->op_pacl);
 	}
+	status = nfsd4_acl41_to_attr(open->op_dacl, open->op_sacl, &attrs);
+	if (status)
+		return status;
 
 	v_mtime = 0;
 	v_atime = 0;
@@ -505,6 +516,10 @@ nfsd4_create_file(struct svc_rqst *rqstp, struct svc_fh *fhp,
 		open->op_bmval[2] &= ~FATTR4_WORD2_POSIX_DEFAULT_ACL;
 	if (attrs.na_paclerr)
 		open->op_bmval[2] &= ~FATTR4_WORD2_POSIX_ACCESS_ACL;
+	if (attrs.na_daclerr)
+		open->op_bmval[1] &= ~FATTR4_WORD1_DACL;
+	if (attrs.na_saclerr)
+		open->op_bmval[1] &= ~FATTR4_WORD1_SACL;
 out:
 	nfsd_attrs_free(&attrs);
 	return status;
@@ -967,11 +982,15 @@ nfsd4_create(struct svc_rqst *rqstp, struct nfsd4_compound_state *cstate,
 			status = nfserr_inval;
 			goto out_aftermask;
 		}
-		status = nfsd4_acl_to_attr(create->cr_type, create->cr_acl,
-								&attrs);
+		status = nfsd4_acl_to_attr(d_inode(cstate->current_fh.fh_dentry),
+					   create->cr_type,
+					   create->cr_acl, &attrs);
 		if (status != nfs_ok)
 			goto out_aftermask;
 	}
+	status = nfsd4_acl41_to_attr(create->cr_dacl, create->cr_sacl, &attrs);
+	if (status != nfs_ok)
+		goto out_aftermask;
 	current->fs->umask = create->cr_umask;
 	switch (create->cr_type) {
 	case NF4LNK:
@@ -1036,6 +1055,10 @@ nfsd4_create(struct svc_rqst *rqstp, struct nfsd4_compound_state *cstate,
 		create->cr_bmval[2] &= ~FATTR4_WORD2_POSIX_DEFAULT_ACL;
 	if (attrs.na_paclerr)
 		create->cr_bmval[2] &= ~FATTR4_WORD2_POSIX_ACCESS_ACL;
+	if (attrs.na_daclerr)
+		create->cr_bmval[1] &= ~FATTR4_WORD1_DACL;
+	if (attrs.na_saclerr)
+		create->cr_bmval[1] &= ~FATTR4_WORD1_SACL;
 	set_change_info(&create->cr_cinfo, &cstate->current_fh);
 	fh_dup2(&cstate->current_fh, &resfh);
 out:
@@ -1433,9 +1456,12 @@ nfsd4_setattr(struct svc_rqst *rqstp, struct nfsd4_compound_state *cstate,
 	}
 
 	inode = cstate->current_fh.fh_dentry->d_inode;
-	status = nfsd4_acl_to_attr(S_ISDIR(inode->i_mode) ? NF4DIR : NF4REG,
+	status = nfsd4_acl_to_attr(inode, S_ISDIR(inode->i_mode) ? NF4DIR : NF4REG,
 				   setattr->sa_acl, &attrs);
 
+	if (status)
+		goto out;
+	status = nfsd4_acl41_to_attr(setattr->sa_dacl, setattr->sa_sacl, &attrs);
 	if (status)
 		goto out;
 	save_no_wcc = cstate->current_fh.fh_no_wcc;
@@ -1448,6 +1474,10 @@ nfsd4_setattr(struct svc_rqst *rqstp, struct nfsd4_compound_state *cstate,
 		status = nfserrno(attrs.na_dpaclerr);
 	if (!status)
 		status = nfserrno(attrs.na_paclerr);
+	if (!status)
+		status = nfserrno(attrs.na_daclerr);
+	if (!status)
+		status = nfserrno(attrs.na_saclerr);
 out:
 	fh_drop_write(&cstate->current_fh);
 out_err:
@@ -3645,6 +3675,8 @@ static u32 nfsd4_getattr_rsize(const struct svc_rqst *rqstp,
 
 	if (bmap0 & FATTR4_WORD0_ACL)
 		return nfsd4_max_payload(rqstp);
+	if (bmap1 & (FATTR4_WORD1_DACL | FATTR4_WORD1_SACL))
+		return nfsd4_max_payload(rqstp);
 	if (bmap0 & FATTR4_WORD0_FS_LOCATIONS)
 		return nfsd4_max_payload(rqstp);
 
diff --git a/fs/nfsd/nfs4xdr.c b/fs/nfsd/nfs4xdr.c
index 49e886d41..f640f64e6 100644
--- a/fs/nfsd/nfs4xdr.c
+++ b/fs/nfsd/nfs4xdr.c
@@ -310,21 +310,38 @@ nfsd4_decode_nfsace4(struct nfsd4_compoundargs *argp, struct nfs4_ace *ace)
 	if (!p)
 		return nfserr_bad_xdr;
 	ace->whotype = nfs4_acl_get_whotype((char *)p, length);
-	if (ace->whotype != NFS4_ACL_WHO_NAMED)
+	if (ace->whotype != NFS4_ACL_WHO_NAMED) {
+		/* RFC 8881 6.2.1.5 */
+		ace->flag &= ~NFS4_ACE_IDENTIFIER_GROUP;
 		status = nfs_ok;
-	else if (ace->flag & NFS4_ACE_IDENTIFIER_GROUP)
+	} else if (ace->flag & NFS4_ACE_IDENTIFIER_GROUP)
 		status = nfsd_map_name_to_gid(argp->rqstp,
 				(char *)p, length, &ace->who_gid);
 	else
 		status = nfsd_map_name_to_uid(argp->rqstp,
 				(char *)p, length, &ace->who_uid);
 
+	/*
+	 * Only a filesystem with NFSv4 ACLs can use a name with no local id.
+	 * Which one that is shows at nfsd4_acl_to_attr().
+	 */
+	if (status == nfserr_badowner && length) {
+		char *str = svcxdr_tmpalloc(argp, length);
+
+		if (!str)
+			return nfserr_jukebox;
+		ace->whotype = NFS4_ACL_WHO_STRING;
+		ace->who_str = memcpy(str, p, length);
+		ace->who_strlen = length;
+		status = nfs_ok;
+	}
 	return status;
 }
 
 /* A counted array of nfsace4's */
-static noinline __be32
-nfsd4_decode_acl(struct nfsd4_compoundargs *argp, struct nfs4_acl **acl)
+static __be32
+__nfsd4_decode_acl(struct nfsd4_compoundargs *argp, struct nfs4_acl **acl,
+		   u32 flag)
 {
 	struct nfs4_ace *ace;
 	__be32 status;
@@ -345,6 +362,7 @@ nfsd4_decode_acl(struct nfsd4_compoundargs *argp, struct nfs4_acl **acl)
 	if (*acl == NULL)
 		return nfserr_jukebox;
 
+	(*acl)->flag = flag;
 	(*acl)->naces = count;
 	for (ace = (*acl)->aces; ace < (*acl)->aces + count; ace++) {
 		status = nfsd4_decode_nfsace4(argp, ace);
@@ -355,6 +373,23 @@ nfsd4_decode_acl(struct nfsd4_compoundargs *argp, struct nfs4_acl **acl)
 	return nfs_ok;
 }
 
+static noinline __be32
+nfsd4_decode_acl(struct nfsd4_compoundargs *argp, struct nfs4_acl **acl)
+{
+	return __nfsd4_decode_acl(argp, acl, 0);
+}
+
+/* struct nfsacl41: RFC 8881 6.4.3.2 */
+static noinline __be32
+nfsd4_decode_acl41(struct nfsd4_compoundargs *argp, struct nfs4_acl **acl)
+{
+	u32 flag;
+
+	if (xdr_stream_decode_u32(argp->xdr, &flag) < 0)
+		return nfserr_bad_xdr;
+	return __nfsd4_decode_acl(argp, acl, flag);
+}
+
